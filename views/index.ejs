<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css?v=20260807">
</head>
<body>
  <header class="topbar">
    <h1 class="logo">🎧 LittleEars</h1>

    <!-- 播放模式切换：音箱 / 浏览器 -->
    <div class="mode-switch" id="modeSwitch">
      <span class="mode-switch__label">播放到：</span>
      <button class="mode-btn" data-mode="server">🔊 音箱</button>
      <button class="mode-btn" data-mode="browser">📱 浏览器</button>
    </div>

    <div class="topbar__actions">
      <button class="icon-btn" id="btnRefresh" title="重新扫描音频文件">🔄</button>
      <% if (typeof authEnabled !== 'undefined' && authEnabled) { %>
        <button class="icon-btn" id="btnLogout" title="退出登录">🚪</button>
      <% } %>
    </div>
  </header>

  <!-- 定时暂停：独立于 #player，常驻可见（不随 idle 隐藏） -->
  <section class="sleepbar" id="sleepTimer">
    <span class="sleepbar__icon">⏲</span>
    <select id="sleepHours" class="sleepbar__select" aria-label="定时小时">
      <option value="0">0时</option>
      <option value="1">1时</option>
      <option value="2">2时</option>
      <option value="3">3时</option>
      <option value="4">4时</option>
      <option value="5">5时</option>
      <option value="6">6时</option>
      <option value="7">7时</option>
      <option value="8">8时</option>
    </select>
    <select id="sleepMins" class="sleepbar__select" aria-label="定时分钟">
      <option value="0">0分</option>
      <option value="15">15分</option>
      <option value="30">30分</option>
      <option value="45">45分</option>
    </select>
    <button class="sleepbar__btn" id="btnSleepStart">启动定时</button>
    <span class="sleepbar__countdown" id="sleepCountdown" hidden></span>
    <button class="sleepbar__cancel" id="btnSleepCancel" hidden title="取消定时">✕</button>
  </section>

  <main class="content">
    <!-- 播放状态 + 控制栏 -->
    <section class="player" id="player" hidden>
      <div class="player__now">
        <span class="player__icon" id="playerIcon">▶</span>
        <span class="player__name" id="playerName">-</span>
        <span class="player__count" id="playerCount">0/0</span>
      </div>

      <!-- 进度条 -->
      <div class="player__progress">
        <input type="range" id="progressBar" min="0" max="100" value="0" step="0.1" disabled>
        <span class="player__time" id="timeDisplay">0:00 / 0:00</span>
      </div>

      <!-- 控制按钮 -->
      <div class="player__controls">
        <button class="ctrl-btn" id="btnPrev" title="上一首">⏮</button>
        <button class="ctrl-btn ctrl-btn--big" id="btnPause" title="暂停/播放">⏸</button>
        <button class="ctrl-btn" id="btnNext" title="下一首">⏭</button>
        <button class="ctrl-btn" id="btnStop" title="停止">⏹</button>
      </div>

      <!-- 音量（仅音箱模式显示） -->
      <div class="player__volume" id="volumeBar" hidden>
        <span class="volume-icon">🔉</span>
        <input type="range" id="volumeSlider" min="0" max="100" step="1" value="80">
        <span class="volume-value" id="volumeValue">80</span>
      </div>

      <!-- 循环模式 -->
      <div class="player__modes">
        <button class="mode2-btn" data-playmode="single" title="单曲循环">🔂</button>
        <button class="mode2-btn" data-playmode="sequential" title="顺序播放">🔁</button>
        <button class="mode2-btn" data-playmode="shuffle" title="随机播放">🔀</button>
      </div>
    </section>

    <!-- 音频文件树 -->
    <section class="file-tree" id="fileTree">
      <p class="loading">加载中…</p>
    </section>
  </main>

  <!-- 浏览器模式使用的隐藏 audio 元素 -->
  <audio id="audio" preload="none"></audio>

  <!-- v=20260807 缓存版本号：代码更新后需手动递增，强制浏览器拉新 -->
  <script src="/js/app.js?v=20260807"></script>
</body>
</html>
